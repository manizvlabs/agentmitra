# Agent Mitra Backend Environment Configuration
# Database Configuration - matching flyway.conf settings
DATABASE_URL=postgresql://manish:root@localhost:5433/agentmitra_dev

# Application Settings
APP_NAME=Agent Mitra API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8012

# SSL Configuration
USE_SSL=true
SSL_KEYFILE=ssl/key.pem
SSL_CERTFILE=ssl/cert.pem

# JWT Configuration
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration
REDIS_URL=redis://localhost:6379

# OTP Configuration
OTP_EXPIRY_MINUTES=5
