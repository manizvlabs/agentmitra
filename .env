# Agent Mitra Backend Environment Variables
# This file contains all environment variables for the Agent Mitra application
# It is committed to git for team sharing and deployment consistency

# ========================================
# APPLICATION SETTINGS
# ========================================
APP_NAME=Agent Mitra API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ========================================
# SERVER CONFIGURATION
# ========================================
API_HOST=0.0.0.0
API_PORT=8015

# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ========================================
# SECURITY & AUTHENTICATION
# ========================================
JWT_SECRET_KEY=dev-secret-key-change-in-production-minimum-32-chars-required
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# OTP CONFIGURATION
# ========================================
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_HOUR=5

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMITING_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10000/hour
RATE_LIMIT_OTP=50/hour
RATE_LIMIT_IMPORT=50/minute
RATE_LIMIT_ANALYTICS=500/minute

# ========================================
# EXTERNAL APIs
# ========================================
# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
# The chatbot will use fallback responses if API key is not set or invalid
OPENAI_API_KEY=sk-dev-key-placeholder-change-in-production
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7
OPENAI_ORGANIZATION=your-org-id

# ========================================
# SMS PROVIDER CONFIGURATION
# ========================================
SMS_PROVIDER=twilio
# Twilio Configuration
TWILIO_ACCOUNT_SID=AC-dev-placeholder-change-in-production
TWILIO_AUTH_TOKEN=dev-twilio-auth-token-placeholder
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MG-dev-placeholder
# AWS SNS (alternative)
SMS_API_KEY=dev-sms-api-key-placeholder
SMS_API_SECRET=dev-sms-api-secret-placeholder
SMS_FROM_NUMBER=+1234567890
SMS_SENDER_ID=AGMITR

# ========================================
# AWS CONFIGURATION (for SNS)
# ========================================
AWS_ACCESS_KEY_ID=dev-aws-access-key-placeholder
AWS_SECRET_ACCESS_KEY=dev-aws-secret-key-placeholder
AWS_REGION=us-east-1

# ========================================
# EMAIL PROVIDER CONFIGURATION
# ========================================
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=dev-email-placeholder@gmail.com
EMAIL_PASSWORD=dev-app-password-placeholder
EMAIL_FROM=dev-email-placeholder@gmail.com

# ========================================
# FEATUREHUB CONFIGURATION
# ========================================
FEATUREHUB_URL=http://localhost:8071
FEATUREHUB_API_KEY=dev-featurehub-api-key-placeholder
FEATUREHUB_ENVIRONMENT=development
FEATUREHUB_SDK_KEY=dev-featurehub-sdk-key-placeholder
FEATUREHUB_POLL_INTERVAL=30
FEATUREHUB_STREAMING=true
FEATUREHUB_ADMIN_TOKEN=dev-admin-token-placeholder
FEATUREHUB_ADMIN_SDK_URL=http://localhost:8071

# ========================================
# MINIO STORAGE CONFIGURATION
# ========================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=agentmitra-media
MINIO_USE_SSL=false
MINIO_CDN_BASE_URL=http://localhost:9000/agentmitra-media

# ========================================
# WHATSAPP BUSINESS API CONFIGURATION
# ========================================
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=dev-whatsapp-access-token-placeholder
WHATSAPP_BUSINESS_ACCOUNT_ID=dev-business-account-id-placeholder
WHATSAPP_BUSINESS_NUMBER=+1234567890
WHATSAPP_WEBHOOK_SECRET=dev-webhook-secret-placeholder
WHATSAPP_VERIFY_TOKEN=dev-verify-token-placeholder
WHATSAPP_WEBHOOK_URL=https://your-domain.com/api/v1/whatsapp/webhook

# ========================================
# YOUTUBE INTEGRATION
# ========================================
YOUTUBE_API_KEY=dev-youtube-api-key-placeholder
YOUTUBE_CHANNEL_ID=dev-youtube-channel-id-placeholder
YOUTUBE_CLIENT_ID=dev-youtube-oauth-client-id-placeholder
YOUTUBE_CLIENT_SECRET=dev-youtube-oauth-client-secret-placeholder
YOUTUBE_UPLOAD_ENABLED=true
YOUTUBE_DEFAULT_PRIVACY=unlisted

# ========================================
# VIDEO TUTORIAL SYSTEM
# ========================================
VIDEO_MAX_FILE_SIZE_MB=100
VIDEO_ALLOWED_FORMATS=mp4,mov,avi,mkv,webm
VIDEO_MAX_DURATION_SECONDS=900
VIDEO_MIN_DURATION_SECONDS=30
VIDEO_THUMBNAIL_GENERATION=true
VIDEO_TRANSCRIPTION_AUTO=false
VIDEO_PROCESSING_QUEUE=redis_queue
VIDEO_RECOMMENDATION_ENABLED=true
VIDEO_ANALYTICS_ENABLED=true
VIDEO_AUTO_TAGGING_ENABLED=true

# ========================================
# PAYMENT GATEWAY CONFIGURATION
# ========================================
RAZORPAY_KEY_ID=dev-razorpay-key-id-placeholder
RAZORPAY_KEY_SECRET=dev-razorpay-key-secret-placeholder
RAZORPAY_WEBHOOK_SECRET=dev-razorpay-webhook-secret-placeholder
STRIPE_SECRET_KEY=dev-stripe-secret-key-placeholder
STRIPE_PUBLISHABLE_KEY=dev-stripe-publishable-key-placeholder
STRIPE_WEBHOOK_SECRET=dev-stripe-webhook-secret-placeholder

# ========================================
# FEATURE FLAGS (Legacy)
# ========================================
ENABLE_MOCK_DATA=false
ENABLE_ANALYTICS=true
ENABLE_PAYMENT_PROCESSING=false
ENABLE_CHATBOT=true

# ========================================
# LOGGING CONFIGURATION
# ========================================
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_JSON_FORMAT=false

# ========================================
# MONITORING CONFIGURATION
# ========================================
ENABLE_METRICS=true
METRICS_PORT=9090
PROMETHEUS_ENABLED=true

# ========================================
# CORS CONFIGURATION
# ========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8015,http://localhost:3013
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ========================================
# COMPLIANCE CONFIGURATION
# ========================================
IRDAI_COMPLIANCE_ENABLED=true
DPDP_COMPLIANCE_ENABLED=true
AUDIT_LOGGING_ENABLED=true
DATA_ENCRYPTION_ENABLED=true

# ========================================
# CONTENT MANAGEMENT
# ========================================
CONTENT_MAX_FILE_SIZE_MB=100
CONTENT_ALLOWED_VIDEO_TYPES=video/mp4,video/avi,video/mov,video/mkv,video/webm
CONTENT_ALLOWED_DOC_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
CONTENT_CDN_ENABLED=true
CONTENT_COMPRESSION_ENABLED=true

# ========================================
# ANALYTICS CONFIGURATION
# ========================================
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_CACHE_TTL=3600
ANALYTICS_REPORTING_ENABLED=true

# ========================================
# CHATBOT CONFIGURATION
# ========================================
CHATBOT_ENABLED=true
CHATBOT_MODEL=gpt-3.5-turbo
CHATBOT_TEMPERATURE=0.7
CHATBOT_MAX_TOKENS=300
CHATBOT_LANGUAGE=en
CHATBOT_AUTO_ESCALATION_ENABLED=true
CHATBOT_PROACTIVE_SUGGESTIONS_ENABLED=true

# ========================================
# CALLBACK MANAGEMENT
# ========================================
CALLBACK_SLA_HIGH=15
CALLBACK_SLA_MEDIUM=60
CALLBACK_SLA_LOW=240
CALLBACK_AUTO_ASSIGN=true
CALLBACK_ESCALATION_HOURS=24

# ========================================
# PORTAL SERVICE CONFIGURATION (if running separately)
# ========================================
PORTAL_APP_NAME=Agent Configuration Portal
PORTAL_APP_VERSION=1.0.0
PORTAL_DEBUG=true
PORTAL_ENVIRONMENT=development
PORTAL_HOST=0.0.0.0
PORTAL_PORT=3013
PORTAL_JWT_SECRET_KEY=portal-secret-key-change-in-production
PORTAL_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
PORTAL_CORS_ORIGINS=http://localhost:3000,http://localhost:3013
MAIN_API_URL=http://localhost:8015
MAIN_API_TOKEN=
PORTAL_UPLOAD_DIR=./portal_uploads
PORTAL_MAX_UPLOAD_SIZE_MB=50
ENABLE_AGENT_ONBOARDING=true
ENABLE_BULK_IMPORT=true
ENABLE_CALLBACK_MANAGEMENT=true
ENABLE_CONTENT_MANAGEMENT=true
IMPORT_BATCH_SIZE=100
IMPORT_TIMEOUT_SECONDS=300
PORTAL_LOG_LEVEL=INFO
PORTAL_LOG_FILE=./logs/portal.log
PORTAL_SMTP_SERVER=smtp.gmail.com
PORTAL_SMTP_PORT=587
PORTAL_SMTP_USERNAME=dev-portal-email-placeholder@gmail.com
PORTAL_SMTP_PASSWORD=dev-portal-app-password-placeholder

# Google Cloud SQL Configuration (separated for security)
DB_HOST=35.228.130.213
DB_PORT=5432
DB_NAME=agentmitra_dev
DB_USER=manish
# DB_PASSWORD will be read from Google Cloud Secret Manager at runtime
